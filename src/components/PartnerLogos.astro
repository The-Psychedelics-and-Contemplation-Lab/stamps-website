---
/** Partner logos for the footer's `footer-logos` slot (McGill and LDI come from the design system):
 *  Imperial College London (Centre for Psychedelic Research), the University of Exeter and its Psychedelic
 *  Interdisciplinary Centre (EPIC), then the FRQS and the PMHA Alliance. */
import { u } from '../lib/url';
---
<a class="no-icon logo-imperial" href="https://www.imperial.ac.uk/psychedelic-research-centre/" target="_blank" rel="noopener noreferrer" aria-label="Imperial College London — Centre for Psychedelic Research (opens in a new tab)">
  <img src={u('/logos/imperial.webp')} alt="Imperial College London" width="1097" height="120" decoding="async" />
</a>
<a class="no-icon logo-exeter" href="https://www.exeter.ac.uk/" target="_blank" rel="noopener noreferrer" aria-label="University of Exeter (opens in a new tab)">
  <img src={u('/logos/exeter.webp')} alt="University of Exeter" width="652" height="240" decoding="async" />
</a>
<a class="no-icon logo-epic" href="https://www.exeter.ac.uk/research-centres/psychedelic-interdisciplinary-centre/" target="_blank" rel="noopener noreferrer" aria-label="Exeter Psychedelic Interdisciplinary Centre (opens in a new tab)">
  <img src={u('/logos/epic.webp')} alt="Exeter Psychedelic Interdisciplinary Centre (EPIC), University of Exeter" width="240" height="240" decoding="async" />
</a>
<a class="no-icon" href="https://frq.gouv.qc.ca/sante/" target="_blank" rel="noopener noreferrer" aria-label="Fonds de recherche du Québec – Santé (opens in a new tab)">
  <img src={u('/logos/frqs.jpg')} alt="Fonds de recherche du Québec – Santé" width="556" height="160" decoding="async" />
</a>
<a class="no-icon" href="https://www.pmhaa.org/" target="_blank" rel="noopener noreferrer" aria-label="Psychedelic Mental Health Access Alliance (opens in a new tab)">
  <img src={u('/logos/pmha.png')} alt="Psychedelic Mental Health Access Alliance" width="504" height="160" decoding="async" />
</a>
